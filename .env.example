# --- Copy to .env and fill in -------------------------------------------
# Anthropic credentials used by every LangChain agent
SCORPIO_ANTHROPIC_API_KEY=sk-ant-...

# Model selection (override only if you want a different tier)
SCORPIO_MODEL_NAME=claude-opus-4-7
SCORPIO_FAST_MODEL_NAME=claude-haiku-4-5-20251001
SCORPIO_LLM_TEMPERATURE=0.1
SCORPIO_LLM_MAX_TOKENS=4096

# Sandbox container
SCORPIO_SANDBOX_CONTAINER_NAME=scorpio-worker-sandbox
SCORPIO_SANDBOX_IMAGE=scorpio/worker-sandbox:latest
SCORPIO_SANDBOX_COMMAND_TIMEOUT=180
SCORPIO_SANDBOX_AUTO_START=true

# Attacker RAOA loop
SCORPIO_ATTACKER_MAX_ITERATIONS=5

# Logging
SCORPIO_LOG_LEVEL=INFO
